# --- Secrets: never commit ---
*.tfvars
!*.tfvars.example
*.pem
*.key
.env
vault-pass*
**/secrets/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Packer ---
packer_cache/
output-*/
*.box

# --- Ansible ---
*.retry
.ansible/

# --- Media: raw videos go to GitHub Releases, not git ---
docs/media/*.mp4
docs/media/*.mkv
docs/media/raw/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

# Modules do not pin providers; only root configs commit their lock file
terraform/modules/**/.terraform.lock.hcl

# Packer build logs and manifests (may contain host details)
packer/**/logs/
packer/**/manifest.json

# Rendered device configs (contain password hashes)
ansible/build/
